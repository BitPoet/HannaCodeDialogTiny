<?php namespace ProcessWire;

/**
 * Hanna Code Dialog TinyMCE
 * Main integration module.
 * Handles TinyMCE Hooks and connects to ProcessHannaCodeDialog.
 */
class HannaCodeDialogTiny extends WireData implements Module, ConfigurableModule
{
    /** @var string Cached module version */
    private $moduleVersion;

    /** @var string Cached module URL */
    private $moduleUrl;

    /** @var int Auto-add hannacode to toolbar */
    public $auto_add_toolbar = 0;

    /** @var string Prefix for tags to exclude */
    public $exclude_prefix = '_';

    /** @var array List of tags to exclude */
    public $exclude_selection = [];

    public static function getModuleInfo() {
        return [
            'title'    => 'Hanna Code Dialog TinyMCE',
            'version'  => '0.2.1',
            'summary'  => 'Enhances the use of Hanna tags in TinyMCE fields with dialog-based editing via iframe.',
            'author'   => 'Robin Sallis, BitPoet, interrobang',
            'icon'     => 'clone',
            'autoload' => 'template=admin',
            'singular' => true,
            'requires' => 'ProcessWire>=3.0.218, InputfieldTinyMCE, TextformatterHannaCode, PHP>=7.0',
            'installs' => 'ProcessHannaCodeDialogTiny',
        ];

    }

    /**
     * Initialize module and register hooks
     *
     * @return void
     */
    public function ready() {
        $this->moduleVersion = $this->getModuleInfo()['version'];
        $this->moduleUrl = $this->wire()->config->urls->{$this};
        $this->addHookAfter('ProcessPageEdit::execute', $this, 'addPlugins');
        $this->addHookBefore('InputfieldForm::render', $this, 'addCheatSheet');
        $this->addHookAfter('InputfieldTinyMCE::getConfigInputfields', $this, 'addToolbarOption');

        // Auto-add toolbar hooks
        $this->addHookAfter('Modules::saveConfig', $this, 'hookSaveModuleConfig');
        $this->addHookBefore('Fields::save', $this, 'hookSaveField');
    }

    /**
     * Hook: Auto-sync toolbar and plugin when module config is saved
     *
     * @param HookEvent $event
     * @return void
     */
    public function hookSaveModuleConfig(HookEvent $event) {
        if($event->arguments(0) !== $this->className) return;
        $data = $event->arguments(1);
        if(empty($data['auto_add_toolbar'])) return;

        $fields = $this->wire()->fields->find('type=FieldtypeTextarea');
        $pluginPath = $this->wire()->config->urls->{$this->className} . 'tinymce-plugin/HannaCodeDialogTiny.js';

        foreach($fields as $field) {
            if($this->syncHannaCodeSettings($field, $pluginPath)) {
                $field->save();
                $this->message("Auto-updated toolbar and plugin for field: {$field->name}");
            }
        }
    }

    /**
     * Hook: Auto-sync toolbar and plugin when field is saved
     *
     * @param HookEvent $event
     * @return void
     */
    public function hookSaveField(HookEvent $event) {
        if(!$this->auto_add_toolbar) return;
        $field = $event->arguments(0);
        $pluginPath = $this->wire()->config->urls->{$this->className} . 'tinymce-plugin/HannaCodeDialogTiny.js';
        $this->syncHannaCodeSettings($field, $pluginPath);
    }

    /**
     * Hook: Add hannacode to toolbar options list in field config
     *
     * @param HookEvent $event
     * @return void
     */
    public function addToolbarOption(HookEvent $event) {
        /** @var InputfieldWrapper $inputfields */
        $inputfields = $event->return;
        $f = $inputfields->get('toolbar');
        if($f && $f instanceof InputfieldTextTags) {
            $f->addTag('hannacode');
            $label = $this->_('Insert Hanna Code') . " (" . $this->_('requires "HannaCodeDialogTiny" plugin') . ")";
            $name = 'hannacode';

            // Link to the module configuration page
            $url = $this->wire()->config->urls->admin . "module/edit?name=" . $this->className;
            $note = "<a class='pw-tooltip' href='$url' target='_blank' rel='nofollow noopener' title='$label'>$name</a>";

            // Insert sorted into the existing 'Toolbar details:' list
            $prefix = '<span class="detail">' . $this->_('Toolbar details:') . '</span><br />';
            $prefixPos = strpos($f->notes, $prefix);

            if($prefixPos !== false) {
                // We assume the list ends with <br /><br /> based on InputfieldTinyMCEConfigs.php source
                $endPos = strpos($f->notes, '<br /><br />', $prefixPos);
                if($endPos !== false) {
                    $startPos = $prefixPos + strlen($prefix);
                    $existingList = substr($f->notes, $startPos, $endPos - $startPos);

                    // Use regex to split safely, avoiding commas inside attributes
                    $items = preg_split('/, (?=<a)/', $existingList);
                    if($items === false) $items = array($existingList); // Fallback

                    $items[] = $note;

                    // Sort alphabetically by visible text (strip_tags)
                    usort($items, function($a, $b) {
                        return strcasecmp(strip_tags($a), strip_tags($b));
                    });

                    $newList = implode(', ', $items);
                    $f->notes = substr_replace($f->notes, $newList, $startPos, $endPos - $startPos);
                } else {
                    // Fallback if structure doesn't match expected
                    $f->notes .= " | " . $note;
                }
            } else {
                $f->notes .= " | " . $note;
            }
        }
    }



    /**
     * Hook: Add plugin configuration to page edit
     *
     * @param HookEvent $event
     * @return void
     */
    public function addPlugins(HookEvent $event) {
        $config = $this->wire()->config;


        $pg = $event->object->getPage();
        if ( ! $this->hasTinyMCE($pg->template->fields, $pg)) {
            return;
        }

        $processPage = $this->wire()->pages->get('name=hanna-code-dialog-tiny, parent=setup, template=admin');
        $dialogUrl = $processPage->id ? $processPage->url : $config->urls->admin.'setup/hanna-code-dialog-tiny/';
        $dialogUrl .= (strpos($dialogUrl, '?') === false ? '?' : '&').'modal=1';

        $editedPage = $event->wire()->process instanceof ProcessProfile ? $event->wire()->user : $event->object->getPage();

        $settings = [
            'open_tag'       => $this->wire()->modules->getConfig('TextformatterHannaCode', 'openTag') ?: '[[',
            'close_tag'      => $this->wire()->modules->getConfig('TextformatterHannaCode', 'closeTag') ?: ']]',
            'hanna_tags'     => $this->getDropdownTags($editedPage),
            'dropdown_title' => $this->_('Insert Hanna tag'),
            'dialog_title'   => $this->_('Hanna Code Dialog'),
            'dropdown_icon'  => 'sun-o',
            'hover_title'    => $this->_('Doubleclick to edit'),
            'dialog_url'     => $dialogUrl,
            'page_id'        => $editedPage->id,
            'css_url'        => $this->moduleUrl . 'HannaCodeDialogTiny.css?v=' . $this->moduleVersion,
        ];

        $config->js($this->className, $settings);

        $event->return = '<script>var hcdt_config = config.HannaCodeDialogTiny;</script>' . $event->return;
    }

    /**
     * Get list of Hanna tags for dropdown menu
     *
     * @param Page|null $contextPage
     * @return array
     */
    public function ___getDropdownTags($contextPage = null) {
        $tags = [];
        $hanna = $this->wire()->modules->get('TextformatterHannaCode');

        if ( ! $hanna) {
            return $tags;
        }

        foreach ($hanna->hannaCodes()->getAll() as $hc) {
            $name = $hc->name;
            if (strpos($name, $this->exclude_prefix) === 0) {
                continue;
            }
            if (is_array($this->exclude_selection) && in_array($name, $this->exclude_selection)) {
                continue;
            }

            $attrs = $hc->attrs;
            // Check if attrs is not empty (string or array)
            $hasAttrs = ! empty($attrs);
            // Fallback for older method: defining attributes inside code with hc_attr
            if ( ! $hasAttrs && strpos($hc->code, 'hc_attr') !== false) {
                $hasAttrs = true;
            }
            $tags[$name] = ['has_attrs' => $hasAttrs];
        }

        return $tags;
    }

    /**
     * Hook: Add cheatsheet to Hanna Code edit form
     *
     * @param HookEvent $event
     * @return void
     */
    public function addCheatSheet(HookEvent $event) {
        /* @var InputfieldForm $form */
        $form = $event->object;
        if ($form->id !== 'HannaCodeEdit') {
            return;
        }
        $hcAttr = $form->getChildByName('hc_attr');
        if ( ! $hcAttr) {
            return;
        }

        $f = $this->wire()->modules->get('InputfieldMarkup');
        $f->name = 'hcd_info';
        $f->label = $this->_('Attributes cheatsheet for HannaCodeDialogTiny');
        $f->value = file_get_contents(__DIR__ . '/cheatsheet.html');
        $f->icon = 'question-circle';
        $f->collapsed = Inputfield::collapsedYes;
        $form->insertAfter($f, $hcAttr);
    }

    /**
     * Sync toolbar button and plugin based on TextformatterHannaCode presence
     *
     * @param Field $field
     * @param string $pluginPath
     * @return bool True if changes were made
     */
    protected function syncHannaCodeSettings($field, $pluginPath) {
        if ($field->inputfieldClass != 'InputfieldTinyMCE') {
            return false;
        }

        $formatters = $field->textformatters;
        if ( ! is_array($formatters)) return false;
        $hasHanna = in_array('TextformatterHannaCode', $formatters);

        // Sync toolbar
        $toolbar = (string) $field->toolbar;
        $hasButton = strpos($toolbar, 'hannacode') !== false;
        $changed = false;

        if ($hasHanna && ! $hasButton) {
            $field->toolbar = trim($toolbar.' hannacode');
            $changed = true;
        } elseif ( ! $hasHanna && $hasButton) {
            $toolbar = str_replace('hannacode', '', $toolbar);
            $toolbar = preg_replace('/\s+/', ' ', $toolbar);
            $field->toolbar = trim($toolbar);
            $changed = true;
        }

        // Sync external plugin
        $extPlugins = $field->extPlugins;
        if ( ! is_array($extPlugins)) {
            $extPlugins = [];
        }
        $hasPlugin = in_array($pluginPath, $extPlugins);

        if ($hasHanna && ! $hasPlugin) {
            $extPlugins[] = $pluginPath;
            $field->extPlugins = $extPlugins;
            $changed = true;
        } elseif ( ! $hasHanna && $hasPlugin) {
            $extPlugins = array_diff($extPlugins, [$pluginPath]);
            $field->extPlugins = array_values($extPlugins);
            $changed = true;
        }

        return $changed;
    }

    /**
     * Recursively check if any of the fields use TinyMCE
     *
     * @param  iterable  $fields
     * @param  Page  $page
     * @param  array  $visited  Field IDs to prevent infinite recursion
     *
     * @return bool
     */
    protected function hasTinyMCE($fields, $page, &$visited = []) {
        foreach ($fields as $field) {
            if ( ! $field) {
                continue;
            }

            // Prevent infinite recursion
            if (isset($visited[$field->id])) {
                continue;
            }
            $visited[$field->id] = true;

            // Check for TinyMCE in textarea fields
            if ($field->type instanceof FieldtypeTextarea) {
                if ($field->type->getInputfield($page, $field) instanceof InputfieldTinyMCE) {
                    return true;
                }
                continue;
            }

            // Check for TinyMCE in repeater fields
            if ($field->type instanceof FieldtypeRepeater) {
                if ( ! $field->repeaterFields || ! is_array($field->repeaterFields)) {
                    continue;
                }

                $subFields = [];
                foreach ($field->repeaterFields as $fieldId) {
                    $subField = $this->wire()->fields->get($fieldId);
                    if ($subField) {
                        $subFields[] = $subField;
                    }
                }

                if ($this->hasTinyMCE($subFields, $page, $visited)) {
                    return true;
                }
            }
        }

        return false;
    }

    /**
     * Module install
     *
     * @return void
     */
    public function ___install() {
        $mod = $this->modules->get('InputfieldTinyMCE');
        $url = $this->wire()->config->urls->{$this->className};
        $mod->addPlugin($url.'tinymce-plugin/HannaCodeDialogTiny.js');
    }

    /**
     * Module uninstall
     *
     * @return void
     */
    public function ___uninstall() {
        $mod = $this->modules->get('InputfieldTinyMCE');
        $url = $this->wire()->config->urls->{$this->className};
        $mod->removePlugin($url.'tinymce-plugin/HannaCodeDialogTiny.js');
    }

    /**
     * Module upgrade
     *
     * @param string $fromVersion
     * @param string $toVersion
     * @return void
     */
    public function ___upgrade($fromVersion, $toVersion) {
        $mod = $this->modules->get('InputfieldTinyMCE');
        $url = $this->wire()->config->urls->{$this->className};

        // Upgrade from versions prior to 0.2.2
        if(version_compare($fromVersion, '0.2.2', '<')) {
            // Remove old plugin registrations
            $mod->removePlugin($url.'plugins/hannadialog/hannadialog.js');
            $mod->removePlugin($url.'plugins/hannadropdown/hannadropdown.js');
            $mod->removePlugin($url.'plugins/HannaCodeDialogTiny/HannaCodeDialogTiny.js');

            // Add new plugin path
            $mod->addPlugin($url.'tinymce-plugin/HannaCodeDialogTiny.js');

            // Migrate toolbar settings: hannadropdown -> hannacode
            $fields = $this->wire()->fields->find('type=FieldtypeTextarea');
            $count = 0;
            foreach($fields as $field) {
                if($field->inputfieldClass != 'InputfieldTinyMCE') continue;

                $toolbar = $field->toolbar;
                if(strpos($toolbar, 'hannadropdown') !== false) {
                    $toolbar = str_replace('hannadropdown', 'hannacode', $toolbar);
                    $field->set('toolbar', $toolbar);
                    $field->save();
                    $count++;
                }
            }

            if($count > 0) {
                $this->message("Upgraded HannaCodeDialogTiny: Plugin paths updated and migrated $count field(s) from 'hannadropdown' to 'hannacode'.");
            } else {
                $this->message("Upgraded HannaCodeDialogTiny: Plugin paths updated.");
            }
        }
    }

}
