<?php namespace ProcessWire;

/**
 * Hanna Code Dialog TinyMCE
 * Main integration module.
 * Handles TinyMCE Hooks and connects to ProcessHannaCodeDialog.
 */
class HannaCodeDialogTiny extends WireData implements Module, ConfigurableModule
{
    /** @var string Cached module version */
    private $moduleVersion;

    /** @var string Cached module URL */
    private $moduleUrl;

    public static function getModuleInfo() {
        return [
            'title'    => 'Hanna Code Dialog TinyMCE',
            'version'  => '0.8.2', // Cleaned
            'summary'  => 'Enhances the use of Hanna tags in TinyMCE fields with dialog-based editing via iframe.',
            'author'   => 'Robin Sallis, BitPoet, interrobang',
            'icon'     => 'clone',
            'autoload' => 'template=admin',
            'singular' => true,
            'requires' => 'ProcessWire>=3.0.218, InputfieldTinyMCE, TextformatterHannaCode, PHP>=7.0',
            'installs' => 'ProcessHannaCodeDialog',
        ];
    }

    public function ready() {
        $this->moduleVersion = $this->getModuleInfo()['version'];
        $this->moduleUrl = $this->wire()->config->urls->{$this};
        $this->addHookAfter('ProcessPageEdit::execute', $this, 'addPlugins');
        $this->addHookAfter('InputfieldTinyMCE::render', $this, 'configureTinyMCE');
        $this->addHookBefore('InputfieldForm::render', $this, 'addCheatSheet');
    }

    public function configureTinyMCE(HookEvent $event) {
        $inputfield = $event->object;
        $out = $event->return;
        $cssUrl = $this->moduleUrl . 'HannaCodeDialogTiny.css?v=' . $this->moduleVersion;

        $script = "
        <script>
            (function() {
                var fieldName = '".$inputfield->attr('name')."';
                if(typeof ProcessWire.config.InputfieldTinyMCE !== 'undefined' && typeof ProcessWire.config.InputfieldTinyMCE.settings !== 'undefined') {
                    var settings = ProcessWire.config.InputfieldTinyMCE.settings[fieldName];
                    if (settings) {
                        settings.noneditable_class = 'noneditable';
                        
                        if(settings.content_css) {
                            settings.content_css = settings.content_css + ',' + '$cssUrl';
                        } else {
                            settings.content_css = '$cssUrl';
                        }
                        
                        if(!settings.extended_valid_elements) settings.extended_valid_elements = '';
                        settings.extended_valid_elements += ',span[class|contenteditable|data-hcd-code|title]';
                    }
                }
            })();
        </script>";
        $event->return = $script.$out;
    }

    public function addPlugins(HookEvent $event) {
        $config = $this->wire()->config;
        $pg = $event->object->getPage();
        if (!$this->hasTinyMCE($pg->template->fields, $pg)) {
            return;
        }

        $processPage = $this->wire()->pages->get('name=hanna-code-dialog, parent=setup, template=admin');
        $dialogUrl = $processPage->id ? $processPage->url : $config->urls->admin.'setup/hanna-code-dialog/';
        $dialogUrl .= (strpos($dialogUrl, '?') === false ? '?' : '&').'modal=1';

        $editedPage = $event->wire()->process instanceof ProcessProfile ? $event->wire()->user : $event->object->getPage();

        $settings = [
            'open_tag'       => $this->wire()->modules->getConfig('TextformatterHannaCode', 'openTag') ?: '[[',
            'close_tag'      => $this->wire()->modules->getConfig('TextformatterHannaCode', 'closeTag') ?: ']]',
            'hanna_tags'     => $this->getDropdownTags($editedPage),
            'dropdown_title' => $this->_('Insert Hanna tag'),
            'dialog_title'   => $this->_('Hanna Code Dialog'),
            'dropdown_icon'  => $this->moduleUrl . 'img/hannadropdown.svg',
            'hover_title'    => $this->_('Doubleclick to edit'),
            'dialog_url'     => $dialogUrl,
            'page_id'        => $editedPage->id,
            'css_url'        => $this->moduleUrl . 'HannaCodeDialogTiny.css?v=' . $this->moduleVersion,
        ];

        $config->js($this->className, $settings);
        $config->styles->add($this->moduleUrl . "{$this}.css?v=" . $this->moduleVersion);

        $event->return = '<script>var hcdt_config = config.HannaCodeDialogTiny;</script>' . $event->return;
    }

    public function ___getDropdownTags($contextPage = null) {
        $tags = [];
        $hanna = $this->wire()->modules->get('TextformatterHannaCode');

        if ( ! $hanna) {
            return $tags;
        }

        foreach ($hanna->hannaCodes()->getAll() as $hc) {
            $name = $hc->name;
            $excludePrefix = $this->exclude_prefix ?: '_';
            if (strpos($name, $excludePrefix) === 0) {
                continue;
            }
            if (is_array($this->exclude_selection) && in_array($name, $this->exclude_selection)) {
                continue;
            }

            $attrs = $hc->attrs;
            $hasAttrs = !empty($attrs);
            $tags[$name] = ['has_attrs' => $hasAttrs];
        }

        return $tags;
    }



    public function getModuleConfigInputfields(InputfieldWrapper $inputfields) {
        $modules = $this->wire()->modules;

        $f = $modules->InputfieldText;
        $f->name = 'exclude_prefix';
        $f->label = $this->_('Exclude prefix');
        $f->description = $this->_('Tags starting with this prefix will be hidden.');
        $f->value = $this->exclude_prefix ?: '_';
        $inputfields->add($f);

        $f = $modules->InputfieldAsmSelect;
        $f->name = 'exclude_selection';
        $f->label = $this->_('Exclude Hanna tags');
        $f->description = $this->_('Select specific tags to hide.');

        $hanna = $modules->get('TextformatterHannaCode');
        if ($hanna) {
            foreach ($hanna->hannaCodes()->getAll() as $hc) {
                $f->addOption($hc->name);
            }
        }

        $f->value = $this->exclude_selection;
        $inputfields->add($f);
    }

    public function addCheatSheet(HookEvent $event) {
        /* @var InputfieldForm $form */
        $form = $event->object;
        if ($form->id !== 'HannaCodeEdit') {
            return;
        }
        $hcAttr = $form->getChildByName('hc_attr');
        if ( ! $hcAttr) {
            return;
        }

        $f = $this->wire()->modules->get('InputfieldMarkup');
        $f->name = 'hcd_info';
        $f->label = $this->_('Attributes cheatsheet for HannaCodeDialog');
        $f->value = <<<EOT
<style>
.hcd-cheatsheet .mono { font-family:monospace; font-size:14px; background:#f0f0f0; display:inline-block; padding:1px 5px; border-radius:3px; color:#d00; }
.hcd-cheatsheet .mono-block { padding:5px 10px; margin:0 0 10px; display:block; background:#f9f9f9; border-left: 3px solid #ccc; }
</style>
<div class='hcd-cheatsheet'>
    <p>Use a double underscore to define <span class='mono'>type</span>, <span class='mono'>options</span>, <span class='mono'>description</span> or <span class='mono'>notes</span> for an attribute.</p>
    <p><strong>Example: attribute named 'vegetables'...</strong></p>
    
    <h3>1. Inputfield Types</h3>
    <p class='mono mono-block'>vegetables__type=asmselect</p>
    <p><strong>Supported types:</strong></p>
    <ul>
        <li><span class='mono'>text</span> (Default)</li>
        <li><span class='mono'>textarea</span> (Linebreaks get removed)</li>
        <li><span class='mono'>integer</span> (HTML5 Number)</li>
        <li><span class='mono'>checkbox</span> (Single toggle)</li>
        <li><span class='mono'>radios</span></li>
        <li><span class='mono'>select</span> (Dropdown)</li>
        <li><span class='mono'>selectmultiple</span></li>
        <li><span class='mono'>checkboxes</span> (Multiple)</li>
        <li><span class='mono'>asmselect</span> (Sortable Multiple)</li>
        <li><span class='mono'>pagelistselect</span></li>
        <li><span class='mono'>pagelistselectmultiple</span></li>
    </ul>

    <h3>2. Options (for Selects, Radios, etc)</h3>
    
    <p><strong>A) Simple List:</strong></p>
    <p class='mono mono-block'>vegetables__options=Spinach|Pumpkin|Celery</p>
    
    <p><strong>B) Key/Value pairs:</strong><br>
    Use a colon <code>:</code> to separate saved value from displayed label.</p>
    <p class='mono mono-block'>vegetables__options=spinach:Fresh Spinach|pumpkin:Tasty Pumpkin</p>

    <p><strong>C) Dynamic Options (via Hanna Code):</strong><br>
    You can use another Hanna tag to generate the options string.</p>
    <p class='mono mono-block'>vegetables__options=[[_generate_vegetable_options]]</p>

    <h3>3. Description & Notes</h3>
    <p class='mono mono-block'>
        vegetables__description=Select ingredients for your soup.<br>
        vegetables__notes=Pumpkin tastes best in autumn.
    </p>
</div>
EOT;
        $f->icon = 'question-circle';
        $f->collapsed = Inputfield::collapsedYes;
        $form->insertAfter($f, $hcAttr);
    }

    public function ___install() {
        $mod = $this->modules->get('InputfieldTinyMCE');
        $url = $this->wire()->config->urls->{$this->className};
        $mod->addPlugin($url.'plugins/hannadialog/hannadialog.js');
        $mod->addPlugin($url.'plugins/hannadropdown/hannadropdown.js');
    }

    public function ___uninstall() {
        $mod = $this->modules->get('InputfieldTinyMCE');
        $url = $this->wire()->config->urls->{$this->className};
        $mod->removePlugin($url.'plugins/hannadropdown/hannadropdown.js');
        $mod->removePlugin($url.'plugins/hannadialog/hannadialog.js');
    }

    /**
     * Recursively check if any of the fields use TinyMCE
     *
     * @param  iterable  $fields
     * @param  Page  $page
     * @param  array  $visited  Field IDs to prevent infinite recursion
     *
     * @return bool
     */
    protected function hasTinyMCE($fields, $page, &$visited = []) {
        foreach ($fields as $field) {
            if ( ! $field) {
                continue;
            }

            // Prevent infinite recursion
            if (isset($visited[$field->id])) {
                continue;
            }
            $visited[$field->id] = true;

            // Check for TinyMCE in textarea fields
            if ($field->type instanceof FieldtypeTextarea) {
                if ($field->type->getInputfield($page, $field) instanceof InputfieldTinyMCE) {
                    return true;
                }
                continue;
            }

            // Check for TinyMCE in repeater fields
            if ($field->type instanceof FieldtypeRepeater) {
                if ( ! $field->repeaterFields || ! is_array($field->repeaterFields)) {
                    continue;
                }

                $subFields = [];
                foreach ($field->repeaterFields as $fieldId) {
                    $subField = $this->wire()->fields->get($fieldId);
                    if ($subField) {
                        $subFields[] = $subField;
                    }
                }

                if ($this->hasTinyMCE($subFields, $page, $visited)) {
                    return true;
                }
            }
        }

        return false;
    }
}